+        for (w, h) in [(4096, 2048), (2048, 4096), (2048, 2048), (4096, 4096)] {
+            let (tw, th) = bc_fallback_target(w, h);
+            assert!(tw as u64 * th as u64 <= BC_FALLBACK_MAX_PIXELS as u64,
+                    "{w}x{h} -> {tw}x{th} exceeds the memory budget");
