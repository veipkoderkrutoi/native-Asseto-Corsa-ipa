+/// Complete, device-independent sampler configuration. Both the descriptor and
+/// the bind group layout are derived from this, so they cannot disagree.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct SamplerConfig {
+    pub mag_filter: wgpu::FilterMode,
+    pub min_filter: wgpu::FilterMode,
+    pub mipmap_filter: wgpu::MipmapFilterMode,
+    pub anisotropy_clamp: u16,
+    pub compare: Option<wgpu::CompareFunction>,
+    pub binding_type: wgpu::SamplerBindingType,
+}
+
+impl SamplerConfig {
+    /// wgpu-core 30.0.1 device/resource.rs:2288 requires all three filters to
+    /// be Linear when anisotropy_clamp != 1. Sampler filtering (used by the
+    /// bind group check) is min_filter == Linear || mag_filter == Linear.
+    pub(crate) fn is_wgpu_valid(&self) -> bool {
+        if self.anisotropy_clamp < 1 {
+            return false;
+        }
+        if self.anisotropy_clamp != 1
+            && (self.min_filter != wgpu::FilterMode::Linear
+                || self.mag_filter != wgpu::FilterMode::Linear
+                || self.mipmap_filter != wgpu::MipmapFilterMode::Linear)
+        {
+            return false;
+        }
+        match self.binding_type {
+            wgpu::SamplerBindingType::Filtering => !self.is_comparison(),
+            wgpu::SamplerBindingType::NonFiltering => {
+                !self.is_comparison() && !self.is_filtering()
+            }
+            wgpu::SamplerBindingType::Comparison => self.is_comparison(),
+        }
+    }
+
+    pub(crate) fn is_filtering(&self) -> bool {
+        self.min_filter == wgpu::FilterMode::Linear || self.mag_filter == wgpu::FilterMode::Linear
+    }
+
+    pub(crate) fn is_comparison(&self) -> bool {
+        self.compare.is_some()
+    }
+}
+
+/// The mipmap filter paired with `sampler_filter_mode` in create_sampler.
+pub(crate) fn sampler_mipmap_mode(kind: i32, filter: wgpu::FilterMode) -> wgpu::MipmapFilterMode {
+    if filter == wgpu::FilterMode::Nearest || kind == 3 {
+        wgpu::MipmapFilterMode::Nearest
+    } else {
+        wgpu::MipmapFilterMode::Linear
+    }
+}
+
+/// Anisotropy > 1 requires all filters Linear (wgpu-core 30.0.1). On adapters
+/// without FLOAT32_FILTERABLE the layout is NonFiltering, which requires the
+/// sampler to be Nearest тАФ therefore anisotropy must collapse to 1 there.
+pub(crate) fn sampler_anisotropy_clamp(kind: i32, filterable: bool, requested: i32) -> u16 {
+    if !filterable || kind != 0 {
+        1
+    } else {
+        requested.clamp(1, 16) as u16
+    }
+}
+
+/// Build the exact configuration used for a sampler at a kgl slot.
+pub(crate) fn sampler_config(kind: i32, filterable: bool, requested_anisotropy: i32, comparison: bool) -> SamplerConfig {
+    // kind 3 is the comparison sampler and keeps Linear filters (its own
+    // Comparison binding type). A *plain* kind-3 sampler is never bound to a
+    // Comparison slot, so on a NonFiltering layout it must still be Nearest.
+    let filter = if comparison || filterable {
+        sampler_filter_mode(kind, filterable)
+    } else {
+        wgpu::FilterMode::Nearest
+    };
+    SamplerConfig {
+        mag_filter: filter,
+        min_filter: filter,
+        mipmap_filter: sampler_mipmap_mode(kind, filter),
+        anisotropy_clamp: if comparison {
+            1 // keep the original comparison-sampler behaviour (no aniso PCF change)
+        } else {
+            sampler_anisotropy_clamp(kind, filterable, requested_anisotropy)
+        },
+        compare: if comparison {
+            Some(if kind == 3 { wgpu::CompareFunction::Less } else { wgpu::CompareFunction::Never })
+        } else {
+            None
+        },
+        binding_type: sampler_filtering_type(filterable, comparison),
+    }
+}
+
+/// Configuration of the device-wide default sampler (Direct3D's linear/clamped).
+pub(crate) fn default_sampler_config(filterable: bool, comparison: bool) -> SamplerConfig {
+    if comparison {
+        SamplerConfig {
+            // Comparison sampling keeps its original PCF behaviour: Linear min/mag,
+            // Nearest mip and no anisotropy, independent of FLOAT32_FILTERABLE.
+            mag_filter: wgpu::FilterMode::Linear,
+            min_filter: wgpu::FilterMode::Linear,
+            mipmap_filter: wgpu::MipmapFilterMode::Nearest,
+            anisotropy_clamp: 1,
+            compare: Some(wgpu::CompareFunction::Never),
+            binding_type: wgpu::SamplerBindingType::Comparison,
+        }
+    } else {
+        sampler_config(0, filterable, 1, false)
+    }
+}
+
+/// Turn a configuration into the descriptor actually passed to create_sampler.
+pub(crate) fn sampler_descriptor(config: SamplerConfig, address: wgpu::AddressMode) -> wgpu::SamplerDescriptor<'static> {
+    wgpu::SamplerDescriptor {
+        label: None,
+        address_mode_u: address,
+        address_mode_v: address,
+        address_mode_w: address,
+        mag_filter: config.mag_filter,
+        min_filter: config.min_filter,
+        mipmap_filter: config.mipmap_filter,
+        lod_min_clamp: 0.0,
+        lod_max_clamp: 32.0,
+        compare: config.compare,
+        anisotropy_clamp: config.anisotropy_clamp,
+        border_color: None,
+    }
+}
